# Copy to .env on the server; never commit the real file.
# Compose shares one SQLite/media volume between web and worker.
# Mail stays local-only until SharePoint filing and mailbox integration are ready.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=https://relay.example.co.uk/api/auth/callback

# Opt-in connection test. Keep off until the server checks in the handover pass.
RELAY_SHAREPOINT_MODE=off
# Comma-separated SharePoint Project Tracker item IDs, never project numbers.
RELAY_SHAREPOINT_PROJECT_IDS=
# JSON: {"<project-item-id>":{"driveId":"<drive-id>","itemId":"<reports-folder-id>"}}
RELAY_SHAREPOINT_ARCHIVE_FOLDERS={}
