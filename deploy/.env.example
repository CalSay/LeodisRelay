ENTRA_TENANT_ID=replace-with-directory-tenant-id
ENTRA_CLIENT_ID=replace-with-application-client-id
ENTRA_CLIENT_SECRET='replace-with-secret-value'
ENTRA_REDIRECT_URI=https://app.relaybyleodis.com/api/auth/callback

# See docs/sharepoint-connection-2026-09-13.md. Begin off, then read, then write.
RELAY_SHAREPOINT_MODE=off
# Blank reads every project whose SharePoint status is Active or Defects Liability.
RELAY_SHAREPOINT_READ_PROJECT_IDS=
# Writes remain fail-closed and require exact SharePoint item IDs.
RELAY_SHAREPOINT_WRITE_PROJECT_IDS=
RELAY_SHAREPOINT_ARCHIVE_FOLDERS='{}'
